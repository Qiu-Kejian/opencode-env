{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-codegraph", "opencode-session-spawn"],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-pm:8b": {
          "name": "Qwen3-PM 8B (local)",
          "limit": {
            "context": 8192,
            "output": 4096
          }
        },
        "qwen3:8b": {
          "name": "Qwen3 8B (local)",
          "limit": {
            "context": 8192,
            "output": 4096
          }
        }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/kanboard.env": "deny",
      "~/.ssh/*": "deny"
    },
    "bash": {
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "Remove-Item -Recurse *": "deny",
      "git push *": "deny",
      "git reset --hard *": "deny",
      "git clean *": "deny",
      "format *": "deny"
    }
  }
}
