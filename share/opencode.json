{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-codegraph", "opencode-session-spawn"],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/kanboard.env": "deny",
      "~/.ssh/*": "deny"
    },
    "bash": {
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "Remove-Item -Recurse *": "deny",
      "git push *": "deny",
      "git reset --hard *": "deny",
      "git clean *": "deny",
      "format *": "deny"
    }
  }
}
