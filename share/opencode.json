{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-session-spawn"],
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/kanboard.env": "deny",
      "~/.ssh/*": "deny"
    },
    "bash": {
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "Remove-Item -Recurse *": "deny",
      "git push *": "ask",
      "git reset --hard *": "deny",
      "git clean *": "deny",
      "format *": "deny"
    }
  }
}
